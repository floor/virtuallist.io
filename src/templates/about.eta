<div class="about-page">
  <header class="about-header">
    <h1 class="about-header__title"><%= it.t("about.title") %></h1>
    <p class="about-header__subtitle"><%= it.t("about.subtitle") %></p>
  </header>

  <section class="about-section">
    <h2 class="about-section__title"><%= it.t("about.what_title") %></h2>
    <p class="about-text"><%~ it.t("about.what_p1") %></p>
    <p class="about-text"><%~ it.t("about.what_p2", { count: it.count }) %></p>
  </section>

  <section class="about-section">
    <h2 class="about-section__title"><%= it.t("about.neutrality_title") %></h2>
    <p class="about-text"><%~ it.t("about.neutrality_p1") %></p>
    <p class="about-text"><%~ it.t("about.neutrality_p2") %></p>
  </section>

  <section class="about-section">
    <h2 class="about-section__title"><%= it.t("about.crowdsourced_title") %></h2>
    <p class="about-text"><%~ it.t("about.crowdsourced_p1") %></p>
    <p class="about-text"><%~ it.t("about.crowdsourced_p2") %></p>
  </section>

  <section class="about-section">
    <h2 class="about-section__title"><%= it.t("about.opensource_title") %></h2>
    <p class="about-text"><%~ it.t("about.opensource_p") %></p>
    <div class="about-cta-row">
      <a href="https://github.com/floor/virtuallist.io"
         class="about-cta-btn"
         target="_blank"
         rel="noopener noreferrer">
        <%= it.t("about.cta_github") %>
      </a>
      <a href="/about/contribute" class="about-cta-btn about-cta-btn--secondary">
        <%~ it.t("about.cta_contribute") %>
      </a>
    </div>
  </section>

  <section class="about-section">
    <h2 class="about-section__title"><%= it.t("about.privacy_title") %></h2>
    <p class="about-text"><%= it.t("about.privacy_p") %></p>
  </section>
</div>
